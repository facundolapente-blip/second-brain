// Second Brain: journal, hábitos y gastos (el plan semanal llega después).
// App de una sola persona: los datos no llevan userId, el acceso lo cierra ALLOWED_EMAILS.

generator client {
  provider      = "prisma-client-js"
  // El runtime de Vercel es RHEL: sin esto el motor generado no corre en producción.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Journal ────────────────────────────────────────────────────────────────

/// Una entrada del diario. Puede haber más de una por día.
model JournalEntry {
  id         String   @id @default(cuid())
  /// Día al que pertenece la entrada (no cuándo se escribió).
  date       DateTime @db.Date
  title      String?
  body       String   @default("")
  /// Ánimo del 1 (muy mal) al 5 (muy bien). Opcional.
  mood       Int?
  tags       String[] @default([])
  /// De dónde viene: null = escrita en la app; si no, el nombre del importador
  /// (la app de diario de origen). Junto con externalId deja reimportar sin duplicar.
  source     String?
  /// Id de la entrada en la app de origen.
  externalId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  attachments Attachment[]

  @@unique([source, externalId])
  @@index([date])
}

// ─── Hábitos ────────────────────────────────────────────────────────────────
// Modelado a partir de HabitNow, la app que Facu usaba en el celular.

/// Agrupa hábitos y les da ícono y color (Deporte, Salud, Trabajo...).
model HabitCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  /// Nombre del ícono (ver src/lib/habit-icons.ts).
  icon   String  @default("Circle")
  /// Clave de color de la paleta (ver src/lib/palette.ts).
  color  String  @default("stone")
  order  Int     @default(0)
  habits Habit[]
}

model Habit {
  id           String         @id @default(cuid())
  name         String
  description  String?
  categoryId   String?
  category     HabitCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// daily (todos los días) | weekdays (días específicos) | weekly (X veces por semana)
  frequency    String         @default("daily")
  /// Para `weekdays`: días en que toca (0 = domingo).
  weekdays     Int[]          @default([])
  /// Para `weekly`: cuántas veces por semana.
  timesPerWeek Int            @default(1)
  /// Para `weekly`: día en que arranca la semana (1 = lunes, 0 = domingo). Un
  /// "domingo flexible" de HabitNow es 1 vez por semana con la semana desde el domingo.
  weekStart    Int            @default(1)
  /// Cantidad por día para darlo por hecho. 1 sin unidad = hábito de sí/no.
  target       Int            @default(1)
  unit         String?
  /// Prioridad (la banderita): ordena la lista de Hoy, más alta arriba.
  priority     Int            @default(1)
  /// Hábito de dejar algo (No fumar): muestra los días limpios.
  isQuit       Boolean        @default(false)
  /// Inicio de la pista actual: la tarjeta, la racha y el puntaje cuentan desde acá.
  /// Las pistas anteriores están en HabitTrack.
  startDate    DateTime       @db.Date
  order        Int            @default(0)
  archivedAt   DateTime?
  createdAt    DateTime       @default(now())
  logs         HabitLog[]
  tracks       HabitTrack[]
  planBlocks   PlanBlock[]
}

/// Una pista cerrada (como en HabitNow): un tramo anterior del hábito, con la
/// configuración que tenía entonces. La pista actual vive en Habit.
model HabitTrack {
  id           String   @id @default(cuid())
  habitId      String
  habit        Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  frequency    String
  weekdays     Int[]    @default([])
  timesPerWeek Int      @default(1)
  weekStart    Int      @default(1)
  target       Int      @default(1)

  @@index([habitId])
}

/// Lo marcado en un día. Sin fila = sin marcar.
model HabitLog {
  id      String   @id @default(cuid())
  habitId String
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    DateTime @db.Date
  /// done | failed | skipped | none (solo nota). En hábitos de cantidad, `done` se deriva de value >= target.
  status  String   @default("done")
  value   Int      @default(1)
  /// Nota del día ("hoy fumé uno después de cenar").
  note    String?
  /// De dónde vino la marca: "app" (marcada acá) o null/"habitnow" (importada).
  /// Reimportar HabitNow nunca pisa una marca de la app.
  source  String?

  @@unique([habitId, date])
  @@index([date])
}

// ─── Gastos ─────────────────────────────────────────────────────────────────
// Modelado a partir de la app de gastos que Facu usaba en el celular: varias
// cuentas (cada una con su moneda), movimientos siempre atados a una cuenta y
// transferencias entre cuentas (también entre UYU y USD).
//
// El saldo no se guarda: se calcula como saldo inicial + ingresos - gastos
// +/- transferencias (src/lib/finance-logic.ts). Los montos se guardan siempre
// positivos y el signo lo da `kind`, así los análisis no dependen de convenciones.

model Account {
  id             String                 @id @default(cuid())
  name           String
  /// cash | bank | card | savings | investment
  type           String                 @default("bank")
  /// Código ISO: UYU, USD, ARS, EUR...
  currency       String                 @default("UYU")
  initialBalance Decimal                @default(0) @db.Decimal(14, 2)
  /// Nombre del ícono (ver src/lib/finance-icons.tsx).
  icon           String                 @default("Wallet")
  /// Clave de color de la paleta (ver src/lib/palette.ts).
  color          String                 @default("stone")
  order          Int                    @default(0)
  /// Tarjeta de crédito: día del mes en que cierra el estado de cuenta y en que vence.
  closingDay     Int?
  dueDay         Int?
  /// Límite de la tarjeta (opcional).
  creditLimit    Decimal?               @db.Decimal(14, 2)
  archivedAt     DateTime?
  createdAt      DateTime               @default(now())
  transactions   Transaction[]          @relation("TxAccount")
  transfersIn    Transaction[]          @relation("TxToAccount")
  templates      TxTemplate[]           @relation("TplAccount")
  templatesIn    TxTemplate[]           @relation("TplToAccount")
  schedules      ScheduledTransaction[] @relation("SchAccount")
  schedulesIn    ScheduledTransaction[] @relation("SchToAccount")
}

/// Categoría de gasto o de ingreso. Un movimiento sin categoría es "Sin clasificar".
model Category {
  id           String                 @id @default(cuid())
  name         String
  /// expense | income
  kind         String                 @default("expense")
  /// Nombre del ícono (ver src/lib/finance-icons.tsx).
  icon         String                 @default("Tag")
  color        String                 @default("stone")
  order        Int                    @default(0)
  archivedAt   DateTime?
  /// "Ajuste de saldo": corrige el saldo de una cuenta sin contar como gasto ni ingreso.
  isAdjustment Boolean                @default(false)
  transactions Transaction[]
  templates    TxTemplate[]
  schedules    ScheduledTransaction[]
  budget       CategoryBudget?

  @@unique([name, kind])
}

/// Presupuesto mensual de una categoría de gasto: lo mismo todos los meses.
model CategoryBudget {
  id         String   @id @default(cuid())
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Decimal  @db.Decimal(14, 2)
  /// Solo cuentan los gastos de cuentas en esta moneda.
  currency   String   @default("UYU")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Presupuesto puntual (un viaje, las vacaciones, una mudanza): un monto total
/// y los movimientos que se le asignan.
model BudgetProject {
  id           String        @id @default(cuid())
  name         String
  /// Nombre del ícono (ver src/lib/finance-icons.tsx).
  icon         String        @default("Airplane")
  color        String        @default("teal")
  amount       Decimal       @db.Decimal(14, 2)
  currency     String        @default("UYU")
  startDate    DateTime?     @db.Date
  endDate      DateTime?     @db.Date
  note         String?
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

/// Un movimiento. El monto siempre es positivo: el signo lo da `kind`.
/// En una transferencia sale `amount` de `account` y entra `toAmount` en
/// `toAccount` (distintos si las cuentas tienen distinta moneda; iguales si no).
model Transaction {
  id          String                @id @default(cuid())
  /// expense | income | transfer
  kind        String
  /// Día del movimiento (YYYY-MM-DD en America/Montevideo).
  date        DateTime              @db.Date
  /// Lo que se ve en la lista ("Dominos", "Psiquiatra"). Vacío = "Sin título".
  title       String?
  amount      Decimal               @db.Decimal(14, 2)
  accountId   String
  account     Account               @relation("TxAccount", fields: [accountId], references: [id], onDelete: Restrict)
  /// Solo en gastos e ingresos. Null = sin clasificar.
  categoryId  String?
  category    Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Solo en transferencias.
  toAccountId String?
  toAccount   Account?              @relation("TxToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  toAmount    Decimal?              @db.Decimal(14, 2)
  note        String?
  /// Presupuesto puntual al que se asignó (viaje, vacaciones...).
  projectId   String?
  project     BudgetProject?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  /// Si lo generó una orden permanente o un movimiento programado.
  scheduleId  String?
  schedule    ScheduledTransaction? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  /// De dónde vino: null = cargado a mano; "import:<app>" = importado.
  source      String?
  /// Id en el sistema de origen, para no duplicar al reimportar.
  externalId  String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @default(now()) @updatedAt

  @@unique([source, externalId])
  /// Compra en cuotas: todas las cuotas comparten el grupo; cada una va en su mes.
  installmentGroup String?
  installmentNo    Int?
  installmentCount Int?
  attachments Attachment[]

  @@index([installmentGroup])
  @@index([date])
  @@index([accountId])
  @@index([toAccountId])
  @@index([categoryId])
  @@index([projectId])
}

/// Plantilla: un movimiento guardado para repetirlo rápido (el monto es opcional).
model TxTemplate {
  id          String    @id @default(cuid())
  name        String
  kind        String
  title       String?
  amount      Decimal?  @db.Decimal(14, 2)
  accountId   String?
  account     Account?  @relation("TplAccount", fields: [accountId], references: [id], onDelete: SetNull)
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  toAccountId String?
  toAccount   Account?  @relation("TplToAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  toAmount    Decimal?  @db.Decimal(14, 2)
  note        String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
}

/// Orden permanente (se repite: alquiler todos los meses) o movimiento
/// programado (una sola vez, en el futuro). Todavía no hay proceso que los
/// genere: cuando exista, crea un Transaction con `scheduleId` en `nextDate`
/// y corre `nextDate` según la frecuencia.
model ScheduledTransaction {
  id           String        @id @default(cuid())
  kind         String
  title        String?
  amount       Decimal       @db.Decimal(14, 2)
  accountId    String
  account      Account       @relation("SchAccount", fields: [accountId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  toAccountId  String?
  toAccount    Account?      @relation("SchToAccount", fields: [toAccountId], references: [id], onDelete: Cascade)
  toAmount     Decimal?      @db.Decimal(14, 2)
  note         String?
  /// once | daily | weekly | monthly | yearly
  frequency    String        @default("monthly")
  /// Cada cuántas unidades de `frequency` (2 + weekly = cada dos semanas).
  interval     Int           @default(1)
  startDate    DateTime      @db.Date
  /// Próxima vez que toca generar el movimiento. Null = terminada.
  nextDate     DateTime?     @db.Date
  endDate      DateTime?     @db.Date
  /// true: se carga sola; false: pide confirmación antes de cargarla.
  autoConfirm  Boolean       @default(true)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([nextDate])
}

// ─── Deudas y metas de ahorro ───────────────────────────────────────────────

/// Plata prestada o debida ("Deuda fede", "Nafta (me pagan)").
model Debt {
  id         String    @id @default(cuid())
  person     String
  /// owed_to_me (me deben) | i_owe (debo)
  direction  String
  amount     Decimal   @db.Decimal(14, 2)
  currency   String    @default("UYU")
  date       DateTime  @db.Date
  note       String?
  /// Cuándo se saldó (null = pendiente).
  settledAt  DateTime?
  /// Movimiento con el que se saldó (la devolución o el pago), si se cargó.
  settleTxId String?
  createdAt  DateTime  @default(now())

  @@index([settledAt])
}

/// Meta de ahorro: un monto a juntar, opcionalmente para una fecha. El avance
/// sale del saldo de una cuenta o de lo que se va sumando a mano.
model SavingsGoal {
  id         String    @id @default(cuid())
  name       String
  icon       String    @default("PiggyBank")
  color      String    @default("green")
  target     Decimal   @db.Decimal(14, 2)
  currency   String    @default("UYU")
  deadline   DateTime? @db.Date
  /// Si está, el avance es el saldo de esa cuenta.
  accountId  String?
  /// Si no hay cuenta: lo juntado, cargado a mano.
  saved      Decimal   @default(0) @db.Decimal(14, 2)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ─── Papelera y actividad ───────────────────────────────────────────────────

/// Lo borrado en cualquier módulo: la foto completa para poder restaurarlo.
/// Se vacía sola a los 30 días.
model TrashItem {
  id        String   @id @default(cuid())
  /// transaction | account | category | template | schedule | project | debt | goal |
  /// habit | habitCategory | journal | block | task | keyResult
  kind      String
  entityId  String
  /// Cómo se muestra ("Gasto $ 350 · Almuerzo").
  label     String
  /// habitos | journal | gastos | plan
  module    String
  data      Json
  deletedAt DateTime @default(now())

  @@index([deletedAt])
}

/// Qué se hizo en la app: creado, editado, borrado, restaurado, importado.
model Activity {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  /// created | updated | deleted | restored | purged | imported | done
  action   String
  kind     String
  entityId String?
  label    String
  module   String

  @@index([at])
}

// ─── Ajustes de la app ───────────────────────────────────────────────────────

/// Valores sueltos que guarda la app (por ejemplo, la última cotización del dólar).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Check-in diario ────────────────────────────────────────────────────────

/// Cómo estuvo el día, en pocos toques desde Inicio. Uno por día; todo opcional.
model DailyCheckin {
  id         String   @id @default(cuid())
  date       DateTime @unique @db.Date
  /// Ánimo del 1 (muy mal) al 5 (muy bien), la misma escala que el journal.
  mood       Int?
  /// Energía del 1 al 5.
  energy     Int?
  /// Estrés del 1 (nada) al 5 (mucho).
  stress     Int?
  /// Horas dormidas la noche anterior, en minutos.
  sleepMin   Int?
  /// Peso en gramos.
  weightG    Int?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Login (Better Auth) ────────────────────────────────────────────────────

/// Intentos de login por IP (límite de Better Auth). En la base y no en memoria:
/// en Vercel cada instancia tendría su propio contador.
model AuthRateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model AuthUser {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      AuthSession[]
  accounts      AuthAccount[]

  @@map("auth_user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model AuthAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AuthUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  /// Hash de la contraseña (nunca la contraseña en claro).
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("auth_account")
}

model AuthVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

// ─── Plan semanal ───────────────────────────────────────────────────────────
// Reemplaza el "Plan Semanal" de Notion de Facu: bloques de la semana (Daily
// Planning), tareas (Para hacer) y objetivos con resultados clave.

model PlanCategory {
  id     String      @id @default(cuid())
  name   String      @unique
  /// Clave de color de la paleta (ver src/lib/palette.ts).
  color  String      @default("stone")
  order  Int         @default(0)
  tasks  PlanTask[]
  blocks PlanBlock[]
}

/// Una tarea con o sin deadline ("Para hacer").
model PlanTask {
  id          String        @id @default(cuid())
  title       String
  categoryId  String?
  category    PlanCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// backlog (Programadas, para algún día) | todo (Sin empezar) | doing (En curso) | done (Terminado)
  status      String        @default("todo")
  /// 0 a 4 fueguitos.
  priority    Int           @default(1)
  deadline    DateTime?     @db.Date
  /// Progreso y meta numéricos opcionales (por ejemplo 2 de 3 entregas).
  progress    Int?
  goal        Int?
  /// "Agendada": ya tiene lugar en la semana.
  scheduled   Boolean       @default(false)
  notes       String?
  completedAt DateTime?
  /// Tarea que se repite: al terminarla aparece la siguiente (daily | weekly | monthly).
  repeat      String?
  repeatEvery Int           @default(1)
  source      String?
  externalId  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  blocks      PlanBlock[]
  subtasks    PlanSubtask[]

  @@unique([source, externalId])
  @@index([status])
}

/// Paso de una tarea (checklist).
model PlanSubtask {
  id     String   @id @default(cuid())
  taskId String
  task   PlanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title  String
  done   Boolean  @default(false)
  order  Int      @default(0)

  @@index([taskId])
}

/// Un bloque de la semana ("Daily Planning"): algo para hacer un día, con horario opcional.
model PlanBlock {
  id         String        @id @default(cuid())
  title      String
  categoryId String?
  category   PlanCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date       DateTime      @db.Date
  /// "HH:MM" en hora de Montevideo; sin hora = todo el día.
  startTime  String?
  endTime    String?
  priority   Int           @default(0)
  done       Boolean       @default(false)
  place      String?
  notes      String?
  /// Tarea de la que sale este bloque.
  taskId     String?
  task       PlanTask?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// Hábito vinculado: marcar el bloque como hecho marca el hábito ese día.
  habitId    String?
  habit      Habit?        @relation(fields: [habitId], references: [id], onDelete: SetNull)
  source     String?
  externalId String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([source, externalId])
  @@index([date])
}

/// Un objetivo grande ("Mejorar mi salud", "Cursar 7 materias").
model PlanObjective {
  id         String          @id @default(cuid())
  title      String          @unique
  order      Int             @default(0)
  keyResults PlanKeyResult[]
}

/// Resultado clave de un objetivo, con progreso hacia una meta.
model PlanKeyResult {
  id          String         @id @default(cuid())
  objectiveId String?
  objective   PlanObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  title       String
  /// activity (Actividad) | habit (Hábito)
  kind        String         @default("activity")
  /// todo (Sin empezar) | doing (Haciendo) | done (Completado) | closed (Finalizado sin completar)
  status      String         @default("todo")
  /// Trimestres en los que corre: Q1, Q2, Q3, Q4.
  quarters    String[]       @default([])
  deadline    DateTime?      @db.Date
  progress    Float?
  goal        Float?
  /// Se mide solo: habit (cumplimiento de un hábito), account (saldo de una
  /// cuenta) o goal (meta de ahorro). Null = progreso a mano.
  linkType    String?
  linkId      String?
  source      String?
  externalId  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([source, externalId])
}

// ─── Fotos ──────────────────────────────────────────────────────────────────

/// Foto de una entrada del journal o comprobante de un movimiento. El archivo
/// vive en Vercel Blob privado (`pathname`); se sirve por /api/foto/[id].
model Attachment {
  id             String        @id @default(cuid())
  pathname       String        @unique
  contentType    String
  size           Int
  width          Int?
  height         Int?
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  transactionId  String?
  transaction    Transaction?  @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([journalEntryId])
  @@index([transactionId])
}
